# PostgreSQL (Docker Compose)
# Quote values that start with @ or contain spaces/$/special characters.
POSTGRES_PASSWORD='replace_with_a_strong_password'

# Spring Boot datasource (app runs on the host, outside Docker)
# Prefer a full JDBC URL — the app reads DB_URL (not DB_HOST/DB_PORT/DB_NAME).
DB_URL=jdbc:postgresql://localhost:5432/lms
DB_USERNAME=lms_user
DB_PASSWORD='replace_with_a_strong_password'

# JWT (required). Use a long random secret (at least 32 characters/bytes).
# Spring Boot does not load .env automatically; export these or use:
#   set -a && source .env && set +a && ./mvnw spring-boot:run
JWT_SECRET='replace_with_a_long_random_secret_at_least_32_chars'
JWT_EXPIRATION_MS=3600000

# CORS allowed origins for the sibling platform-ui Vite app (comma-separated, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
